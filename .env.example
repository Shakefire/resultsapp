# Vercel backend environment (never add the service role key to Flutter).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-secret
APP_ORIGINS=https://your-web-app.example

# Cloudflare R2 S3-compatible credentials (server-only Vercel environment).
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-key
R2_BUCKET_NAME=smart-electoral-evidence

# Flutter compile-time configuration:
# flutter run --dart-define=API_BASE_URL=https://your-vercel-project.vercel.app
